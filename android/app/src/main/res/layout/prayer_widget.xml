<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clickable="true"
    android:focusable="true">

    <ImageView
        android:id="@+id/widget_background"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:src="@drawable/bg_v2"
        android:scaleType="centerCrop" />

    <!-- الجهة اليسرى: لوحة المعلومات المعلوماتية (بعد إزالة الهوية) -->
    <LinearLayout
        android:id="@+id/ll_app_info"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentStart="true"
        android:layout_centerVertical="true"
        android:layout_marginStart="36dp"
        android:layout_marginTop="8dp"
        android:orientation="vertical"
        android:gravity="start">

        <TextView
            android:id="@+id/hijri_date"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="-- رمضان ١٤٤٧"
            android:textColor="#FFFFFF"
            android:textSize="10sp"
            android:alpha="0.8"
            android:fontFamily="sans-serif-light" />

        <!-- المساحة المعلوماتية للصلوات -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/past_prayer_display"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="الفجر 04:11 ص"
                android:textColor="#A0FFFFFF"
                android:textSize="9sp"
                android:fontFamily="sans-serif-light" />

            <TextView
                android:id="@+id/next_prayer_display"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="الظهر 11:59 م"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:textStyle="bold"
                android:layout_marginTop="1dp"
                android:fontFamily="sans-serif-medium" />
        </LinearLayout>
    </LinearLayout>

    <!-- الجهة اليمنى: العداد والهوية (داخل الدائرة) -->
    <LinearLayout
        android:id="@+id/ll_prayer_info"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentEnd="true"
        android:layout_centerVertical="true"
        android:layout_marginEnd="42dp"
        android:orientation="vertical"
        android:gravity="center">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="زاد"
            android:textColor="#D4AF37"
            android:textSize="11sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif-medium"
            android:layout_marginBottom="-4dp" />

        <Chronometer
            android:id="@+id/countdown_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#D4AF37"
            android:textSize="18sp"
            android:textStyle="bold"
            android:paddingBottom="4dp"
            android:fontFamily="sans-serif-medium" />
    </LinearLayout>

</RelativeLayout>
